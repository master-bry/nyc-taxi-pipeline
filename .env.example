# NYC Taxi Pipeline Configuration
# Copy to .env and update values as needed

# Environment
ENVIRONMENT=development

# Database
DB_DUCKDB_PATH=data/taxi.duckdb
DB_READ_ONLY=true

# Machine Learning
ML_MODEL_PATH=src/ml/artifacts/best_model.pkl
ML_MLFLOW_TRACKING_URI=http://localhost:5000
ML_MLFLOW_EXPERIMENT=nyc_taxi

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_DEBUG=false
API_LOG_LEVEL=INFO

# Dashboard
DASHBOARD_PAGE_TITLE=NYC Taxi Analytics
DASHBOARD_THEME=dark
DASHBOARD_LAYOUT=wide
DASHBOARD_CACHE_TTL=3600

# Data Paths
DATA_RAW_DATA_PATH=data/raw
DATA_PROCESSED_DATA_PATH=data/processed
DATA_EXPORTS_PATH=exports
DATA_LOGS_PATH=logs
